#!/usr/bin/env bash
# ytmscrap — YouTube / YouTube Music song and playlist downloader for macOS and Git Bash.
set -euo pipefail

usage() {
  cat <<'HELP'
ytmscrap — YouTube Music -> WAV / FLAC

Użycie:
  ytmscrap                Pytania o folder, link do utworu/playlisty i format
  ytmscrap "URL"          Link do utworu albo playlisty; pytanie o folder
  ytmscrap --rekordbox "URL"  Pobierz z przygotowaniem okładek do rekordbox
  ytmscrap --fix-rekordbox [FOLDER] [--dry-run]  FLAC + kwadratowe okładki
  ytmscrap --fix-genres [FOLDER] [--dry-run]  Uzupełnij Genre w plikach FLAC/WAV
  ytmscrap --check-genres  Sprawdź połączenie z bazami gatunków
  ytmscrap --update       Pobierz najnowszą wersję programu z GitHuba
  ytmscrap update         To samo (krótsza forma)
  ytmscrap --check        Sprawdź wymagane narzędzia
  ytmscrap --help         Pokaż pomoc

Spotify -> YouTube Music: https://www.tunemymusic.com/
HELP
}

check_tools() {
  local missing=0 tool
  for tool in yt-dlp ffmpeg deno; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '[OK] %s\n' "$tool"
    else
      printf '[BRAK] %s\n' "$tool" >&2
      missing=1
    fi
  done
  if [ "$missing" -ne 0 ]; then
    printf '\nUruchom instalator: bash install.sh (w folderze repozytorium).\n' >&2
    return 1
  fi
}

python_helper() {
  local script_name=$1
  shift
  local helper="$HOME/.local/share/ytmscrap/$script_name"
  local py=""
  if [ ! -f "$helper" ]; then
    helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/$script_name"
  fi
  if [ ! -f "$helper" ]; then
    printf '[BŁĄD] Brak %s. Zaktualizuj ytmscrap instalatorem.\n' "$script_name" >&2
    return 2
  fi
  for candidate in "$HOME/.local/share/ytmscrap/venv/Scripts/python.exe" "$HOME/.local/share/ytmscrap/venv/bin/python3" "$HOME/.local/share/ytmscrap/venv/bin/python"; do
    if [ -x "$candidate" ]; then
      py=$candidate
      break
    fi
  done
  if [ -z "$py" ]; then
    if command -v python3 >/dev/null 2>&1; then py=python3
    elif command -v python >/dev/null 2>&1; then py=python
    else
      printf '[BŁĄD] Brak Pythona. Zaktualizuj ytmscrap instalatorem.\n' >&2
      return 2
    fi
  fi
  "$py" "$helper" "$@"
}

update_self() {
  if ! command -v curl >/dev/null 2>&1; then
    printf '[BŁĄD] Brak curl. Zainstaluj curl albo uruchom instalator ręcznie.\n' >&2
    return 1
  fi
  local tmp_installer
  tmp_installer=$(mktemp) || {
    printf '[BŁĄD] Nie można utworzyć pliku tymczasowego.\n' >&2
    return 1
  }
  printf '[ytmscrap] Pobieranie najnowszej wersji instalatora...\n'
  if ! curl --fail --location --show-error --silent --retry 2 --output "$tmp_installer" \
      'https://raw.githubusercontent.com/kubamus/ytmscrap/main/install.sh'; then
    printf '[BŁĄD] Nie można pobrać instalatora. Program pozostał bez zmian.\n' >&2
    rm -f -- "$tmp_installer"
    return 1
  fi
  if ! bash -n "$tmp_installer"; then
    printf '[BŁĄD] Pobrany instalator jest niepoprawny. Przerwano aktualizację.\n' >&2
    rm -f -- "$tmp_installer"
    return 1
  fi

  # The official installer refreshes CLI + Python helpers and checks dependencies.
  if bash "$tmp_installer" kubamus/ytmscrap; then
    printf '\n[ytmscrap] Aktualizacja zakończona.\n'
    rm -f -- "$tmp_installer"
    return 0
  fi
  printf '\n[BŁĄD] Aktualizacja nie zakończyła się poprawnie. Sprawdź błędy instalatora.\n' >&2
  rm -f -- "$tmp_installer"
  return 1
}

case "${1:-}" in
  --update|update) if [ "$#" -ne 1 ]; then usage >&2; exit 2; fi; update_self; exit $? ;;
  -h|--help) usage; exit 0 ;;
  --check) check_tools; exit $? ;;
  --fix-genres) shift; python_helper genre_tagger.py "$@"; exit $? ;;
  --check-genres) python_helper genre_tagger.py --check-network; exit $? ;;
  --fix-rekordbox) shift; python_helper rekordbox.py "$@"; exit $? ;;
esac
download_rekordbox=ask
if [ "${1:-}" = --rekordbox ]; then
  download_rekordbox=yes
  shift
fi
if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

printf '\n=== ytmscrap | YouTube Music -> WAV / FLAC ===\n'
printf 'Spotify -> YouTube Music: https://www.tunemymusic.com/\n\n'

check_tools || exit 1
printf '\n'

if ! IFS= read -r -p 'Gdzie zapisać? (Enter lub ./ = bieżący katalog): ' output_dir; then
  printf '\nAnulowano.\n'
  exit 1
fi
output_dir=${output_dir:-.}

# Windows drive paths work in Git Bash (C:\\Music, D:/DJ).
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    if [[ "$output_dir" =~ ^[A-Za-z]:[\\/] ]] && command -v cygpath >/dev/null 2>&1; then
      output_dir=$(cygpath -u "$output_dir")
    fi
    ;;
esac
case "$output_dir" in
  '~') output_dir=$HOME ;;
  '~/'*) output_dir="$HOME/${output_dir#\~/}" ;;
esac

if ! mkdir -p -- "$output_dir"; then
  printf 'Nie można utworzyć folderu: %s\n' "$output_dir" >&2
  exit 1
fi
output_dir=$(cd -- "$output_dir" && pwd -P)

# Git Bash exposes /c/Users/... paths, but the winget yt-dlp executable
# uses native Windows paths. Passing POSIX paths to it can redirect output
# to the current drive root (e.g. \Song.webp) or another wrong folder.
download_dir="$output_dir"
is_windows=0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    is_windows=1
    if ! command -v cygpath >/dev/null 2>&1; then
      printf '[BŁĄD] Brak cygpath. Uruchom program w Git Bash.\n' >&2
      exit 1
    fi
    download_dir=$(cygpath -m "$output_dir")
    if [[ ! "$download_dir" =~ ^[A-Za-z]:/ && ! "$download_dir" =~ ^// ]]; then
      printf '[BŁĄD] Nie mogę ustalić ścieżki Windows: %s\n' "$output_dir" >&2
      exit 1
    fi
    ;;
esac

# Check write access before launching yt-dlp.
if ! write_test=$(mktemp "$output_dir/.ytmscrap-write-XXXXXXXX" 2>/dev/null); then
  printf '[BŁĄD] Brak uprawnień zapisu w folderze: %s\n' "$output_dir" >&2
  exit 1
fi
rm -f -- "$write_test"

media_url=${1:-}
while [ -z "$media_url" ]; do
  if ! IFS= read -r -p 'Link utworu lub playlisty YouTube / YouTube Music: ' media_url; then
    printf '\nAnulowano.\n'
    exit 1
  fi
done

# Distinguish playlist pages from video links. A watch?v=...&list=... URL
# must download ONLY the linked song, not the entire related playlist.
media_type=''
if [[ "$media_url" =~ ^https://(music\.youtube\.com|www\.youtube\.com|m\.youtube\.com|youtube\.com)/playlist\? ]] &&
   [[ "$media_url" =~ [\?\&]list=[A-Za-z0-9_-]+([\&\#]|$) ]]; then
  media_type=playlist
elif [[ "$media_url" =~ ^https://(music\.youtube\.com|www\.youtube\.com|m\.youtube\.com|youtube\.com)/watch\? ]] &&
     [[ "$media_url" =~ [\?\&]v=[A-Za-z0-9_-]{11}([\&\#]|$) ]]; then
  media_type=song
elif [[ "$media_url" =~ ^https://(www\.)?youtu\.be/[A-Za-z0-9_-]{11}([/?\#]|$) ]]; then
  media_type=song
elif [[ "$media_url" =~ ^https://(www\.|m\.)?youtube\.com/(shorts|live)/[A-Za-z0-9_-]{11}([/?\#]|$) ]]; then
  media_type=song
else
  printf 'Niepoprawny link. Podaj adres utworu lub playlisty z YouTube / YouTube Music.\n' >&2
  exit 2
fi

# FLAC remains the default for existing users.
printf '\nWybierz format audio:\n'
printf '  1) WAV  - bez kompresji, wieksze pliki (jakosc zrodla YouTube)\n'
printf '  2) FLAC - bezstratna kompresja, mniejsze pliki [domyslnie]\n'
while :; do
  if ! IFS= read -r -p 'Format [1/2] (Enter = FLAC): ' format_choice; then
    printf '\nAnulowano.\n'
    exit 1
  fi
  case "$format_choice" in
    1|wav|WAV|Wav) audio_format=wav; break ;;
    ''|2|flac|FLAC|Flac) audio_format=flac; break ;;
    *) printf 'Niepoprawny wybor. Wpisz 1 (WAV) lub 2 (FLAC).\n' >&2 ;;
  esac
done

if [ "$audio_format" = wav ]; then
  format_label=WAV
  archive_file="$download_dir/downloaded-wav.txt"
  cover_note='osobny plik JPG (WAV nie obsluguje osadzania okladek w tym trybie)'
else
  format_label=FLAC
  archive_file="$download_dir/downloaded.txt"
  cover_note='okladka osadzona w FLAC'
fi

if [ "$media_type" = song ]; then
  printf '\nŹródło: pojedynczy utwór\n'
else
  printf '\nŹródło: playlista\n'
fi
printf 'Folder: %s\n' "$download_dir"
printf 'Format: %s (bez dodatkowej stratnej kompresji)\n' "$format_label"
printf 'Metadane: tagi; %s\n' "$cover_note"
printf 'Nazwy: Wykonawca - Tytuł.%s (bez numeru playlisty)\n' "$audio_format"
printf 'Historia: %s\n\n' "$archive_file"

if ! IFS= read -r -p 'Rozpocząć pobieranie? [T/n]: ' confirmation; then
  printf '\nAnulowano.\n'
  exit 1
fi
case "$confirmation" in
  n|N|nie|Nie|NIE|no|No|NO) printf 'Anulowano.\n'; exit 0 ;;
esac

rekordbox_mode=0
if [ "$download_rekordbox" = yes ]; then
  rekordbox_mode=1
else
  printf '\nPrzygotować pliki dla rekordbox (FLAC + kwadratowe okładki 1:1)? [t/N]: '
  if ! IFS= read -r rekordbox_answer; then rekordbox_answer=''; fi
  case "$rekordbox_answer" in
    t|T|tak|Tak|TAK|y|Y|yes|Yes|YES) rekordbox_mode=1 ;;
  esac
fi
if [ "$rekordbox_mode" -eq 1 ]; then
  printf 'Tryb rekordbox: FLAC z kwadratową okładką.\n'
  if [ "$audio_format" = wav ]; then
    printf 'WAV pozostanie bez zmian; powstanie obok niego wersja FLAC.\n'
  fi
fi

printf '\nPobieranie...\n\n'

# Separate archives let users get both WAV and FLAC from the same playlist.
# WAV gets a JPG beside the audio: FFmpeg's WAV muxer cannot embed cover art.
yt_args=(
  --ignore-errors
  --remote-components ejs:github
  -f bestaudio
  -x --audio-format "$audio_format"
  --embed-metadata
)
if [ "$media_type" = playlist ]; then
  yt_args+=(--yes-playlist)
else
  yt_args+=(--no-playlist)
fi
if [ "$audio_format" = flac ]; then
  yt_args+=(--embed-thumbnail)
else
  yt_args+=(--write-thumbnail --convert-thumbnails jpg)
fi
yt_args+=(
  --download-archive "$archive_file"
  -o '%(artist,uploader)s - %(track,title)s.%(ext)s'
  -P "$download_dir"
)

manifest=''
if [ "$rekordbox_mode" -eq 1 ]; then
  manifest=$(mktemp)
  trap 'rm -f -- "$manifest"' EXIT
  native_manifest="$manifest"
  if [ "$is_windows" -eq 1 ]; then
    native_manifest=$(cygpath -m "$manifest")
  fi
  yt_args+=(--print-to-file 'after_move:%(filepath)s' "$native_manifest")
fi
yt_args+=("$media_url")

if yt-dlp "${yt_args[@]}"; then
  printf '\nZakończono. Pliki: %s\n' "$download_dir"
  printf 'Uwaga: --ignore-errors pomija niedostępne utwory; sprawdź log powyżej.\n'
  if [ "$rekordbox_mode" -eq 1 ]; then
    if [ -s "$manifest" ]; then
      python_helper rekordbox.py --from-list "$native_manifest" ||
        printf '[UWAGA] Część plików nie została przygotowana dla rekordbox. Uruchom ytmscrap --fix-rekordbox.\n' >&2
    else
      printf '[Rekordbox] Brak nowych utworów (historia pobrań). Dla istniejących: ytmscrap --fix-rekordbox .\n'
    fi
  fi
  printf '\nAutomatycznie uzupełnić gatunki Genre? [T/n]: '
  if IFS= read -r fill_genres; then
    case "$fill_genres" in
      n|N|nie|Nie|NIE|no|No|NO) ;;
      *) python_helper genre_tagger.py "$download_dir" || printf '[UWAGA] Genre nie zostały w pełni uzupełnione. Pliki audio są zachowane.\n' >&2 ;;
    esac
  else
    printf '\n[INFO] Pomijam uzupełnianie gatunków (brak wejścia).\n'
  fi
else
  printf '\nPobieranie przerwane — sprawdź błędy powyżej.\n' >&2
  exit 1
fi
